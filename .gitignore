# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory
# pnpm artifacts (this repo uses bun.lock / package-lock.json)
package-lock.json
pnpm-lock.yaml
pnpm-workspace.yaml
.playwright-mcp/

# agent-internal working state (not part of the open-source tree)
.codex/
.commandcode/
.agent-teams/
.codebuddy

# 打包期生成的演示库（随 npm 包分发，不进版本库）
/demo/

# 私有推广计划：含对具名第三方的逐人判断与触达名单，不进版本库
.scratch/promote-worksplice/
videos
