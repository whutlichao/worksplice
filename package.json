{
  "name": "worksplice",
  "version": "0.1.2",
  "description": "Local workspace for collaborating with persistent pi coding agents",
  "homepage": "https://github.com/whutlichao/worksplice#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whutlichao/worksplice.git"
  },
  "bugs": {
    "url": "https://github.com/whutlichao/worksplice/issues"
  },
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "worksplice": "bin/worksplice.js"
  },
  "files": [
    "bin",
    "demo",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "preinstall": "node bin/install-guard.js",
    "dev": "next dev -H 127.0.0.1 -p 30142",
    "seed:demo": "node scripts/seed-demo.mjs",
    "migrate:i18n-content": "node scripts/migrate-i18n-content.mjs",
    "build:demo-db": "node scripts/build-demo-db.mjs",
    "prepack": "node scripts/build-demo-db.mjs",
    "dev:lan": "next dev -H 0.0.0.0 -p 30142",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 30142",
    "start:lan": "next start -H 0.0.0.0 -p 30142",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=60000 \"lib/**/*.test.mjs\" \"app/**/*.test.mjs\" \"components/**/*.test.mjs\" \"hooks/**/*.test.mjs\"",
    "release": "npm version patch --no-git-tag-version && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.99.2",
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@earendil-works/pi-tui": "0.99.2",
    "better-sqlite3": "13.0.2",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "undici": "8.5.0"
  },
  "devDependencies": {
    "@lobehub/icons": "^5.6.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.14.0",
    "postcss": "^8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5"
  }
}
